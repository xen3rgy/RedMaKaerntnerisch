{
  "meta": {
    "variant": "Mittelkärntnerisch",
    "region": "Villach / Klagenfurt",
    "description": "Soft rules for mapping Standard German to Carinthian dialect. Rules must never be applied blindly; lexicon and examples have priority."
  },
  "priority_order": [
    "lexicon",
    "examples",
    "rules"
  ],
  "vowel_rules": [
    {
      "id": "ue_to_i",
      "description": "In vielen Wörtern wird 'ü' zu 'i'. Beispiel: müde -> miad, Glück -> Glick.",
      "from": "ü",
      "to": [
        "i"
      ],
      "apply_to": "traditional_german_words_only"
    },
    {
      "id": "ue_to_u",
      "description": "In manchen Wörtern wird 'ü' zu 'u'. Beispiel: drücken -> druckn, hüpfen -> hupfn.",
      "from": "ü",
      "to": [
        "u"
      ],
      "apply_to": "limited_set_words"
    },
    {
      "id": "eu_to_ei",
      "description": "In typischen deutschen Wörtern wird 'eu' zu 'ei'. Beispiel: heute -> heit, Leute -> Leit.",
      "from": "eu",
      "to": [
        "ei"
      ],
      "apply_to": "native_german_words_not_loanwords"
    },
    {
      "id": "ei_to_oa_or_a",
      "description": "In manchen Wörtern wird 'ei' zu 'a' oder 'oa'. Beispiel: klein -> klan.",
      "from": "ei",
      "to": [
        "a",
        "oa"
      ],
      "apply_to": "context_dependent"
    }
  ],
  "consonant_rules": [
    {
      "id": "ch_to_h",
      "description": "Das 'ch' wird oft weich oder als 'h' ausgesprochen. Beispiel: sicherlich -> sihalich.",
      "from": "ch",
      "to": [
        "h",
        ""
      ],
      "apply_to": "common_words_only"
    }
  ],
  "grammar_rules": {
    "personal_pronouns": {
      "ich": "i",
      "du": "du",
      "er": "er",
      "sie_singular": "se",
      "es": "es",
      "wir": "wia",
      "ihr": "ihr",
      "sie_plural": "se"
    },
    "articles": {
      "der": "da",
      "die": "de",
      "das": "des",
      "ein": "a",
      "eine": "a"
    },
    "auxiliary_verbs": {
      "haben": "hobn",
      "sein": "sei",
      "werden": "wean"
    },
    "verb_conjugation_guidelines": {
      "goal": "Use natural Villach/Klagenfurt-style conjugations for common verbs. Prefer consistent, simple forms.",
      "notes": [
        "Do not output full conjugation tables to the user unless explicitly asked.",
        "If unsure, keep the verb in a safe dialect form and focus on particles and sentence rhythm.",
        "Prefer one consistent spelling across all responses."
      ],
      "examples": {
        "sagen": {
          "ich": "i sog",
          "du": "du sogst",
          "er_sie_es": "er/se/es sogt",
          "wir": "wia sogn",
          "ihr": "ihr sogts",
          "sie_plural": "se sogn"
        },
        "machen": {
          "ich": "i moch",
          "du": "du mochst",
          "er_sie_es": "er/se/es mocht",
          "wir": "wia mochn",
          "ihr": "ihr mocht's",
          "sie_plural": "se mochn"
        },
        "gehen": {
          "ich": "i geh",
          "du": "du gehst",
          "er_sie_es": "er/se/es geht",
          "wir": "wia gemma",
          "ihr": "ihr gehts",
          "sie_plural": "se gehn"
        },
        "haben": {
          "ich": "i hob",
          "du": "du host",
          "er_sie_es": "er/se/es hot",
          "wir": "wia hobn",
          "ihr": "ihr hobts",
          "sie_plural": "se hobn"
        },
        "können": {
          "ich": "i konn",
          "du": "du konnst",
          "er_sie_es": "er/se/es konn",
          "wir": "wia kennen",
          "ihr": "ihr kennts",
          "sie_plural": "se kennen"
        },
        "müssen": {
          "ich": "i muass",
          "du": "du muasst",
          "er_sie_es": "er/se/es muass",
          "wir": "wia miassn",
          "ihr": "ihr miassts",
          "sie_plural": "se miassn"
        },
        "sein": {
          "ich": "i bin",
          "du": "du bist",
          "er_sie_es": "er/se/es is",
          "wir": "wia san",
          "ihr": "ihr seids",
          "sie_plural": "se san"
        },
        "wollen": {
          "ich": "i will",
          "du": "du willst",
          "er_sie_es": "er/se/es will",
          "wir": "wia wolln",
          "ihr": "ihr wollts",
          "sie_plural": "se wolln"
        },
        "brauchen": {
          "ich": "i brauch",
          "du": "du brauchst",
          "er_sie_es": "er/se/es braucht",
          "wir": "wia brauchn",
          "ihr": "ihr brauchts",
          "sie_plural": "se brauchn"
        },
        "kommen": {
          "ich": "i kumm",
          "du": "du kummst",
          "er_sie_es": "er/se/es kummt",
          "wir": "wia kummen",
          "ihr": "ihr kummts",
          "sie_plural": "se kummen"
        },
        "geben": {
          "ich": "i gib",
          "du": "du gibst",
          "er_sie_es": "er/se/es gibt",
          "wir": "wia gebn",
          "ihr": "ihr gebts",
          "sie_plural": "se gebn"
        },
        "lassen": {
          "ich": "i loss",
          "du": "du losst",
          "er_sie_es": "er/se/es losst",
          "wir": "wia lossn",
          "ihr": "ihr lossts",
          "sie_plural": "se lossn"
        },
        "finden": {
          "ich": "i find",
          "du": "du findest",
          "er_sie_es": "er/se/es findet",
          "wir": "wia findn",
          "ihr": "ihr findets",
          "sie_plural": "se findn"
        }
      }
    },
    "perfect_without_ge": true,
    "notes": [
      "Perfektformen werden oft ohne 'ge-' gebildet: gesagt -> gsogt, gemacht -> gmocht.",
      "Kurzformen und Verschleifungen sind üblich: 'es ist' -> 'es is', 'du wirst' -> 'du weast'."
    ]
  },
  "application_rules": {
    "never_apply_blindly": true,
    "never_change": [
      "Europa",
      "Universität",
      "Mathematik",
      "Physik",
      "Informatik",
      "Internet",
      "Instagram",
      "YouTube"
    ],
    "notes": [
      "Regeln sind nur Hinweise. Wenn ein Wort dadurch unnatürlich wirkt, soll es unverändert bleiben.",
      "Bei Unsicherheit lieber das Hochdeutsche Wort lassen und nur Satzbau/Partikeln dialektal anpassen."
    ]
  }
}